ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG ERP_REVISION
USER root
RUN rm -rf /home/frappe/frappe-bench/apps/erpnextswiss /opt/frappe/local_apps/erpnextswiss
COPY --chown=frappe:frappe source/ /home/frappe/frappe-bench/apps/erpnextswiss/
COPY source-manifest.json /opt/kt-vat-source-manifest.json
USER frappe
RUN /home/frappe/frappe-bench/env/bin/python -m pip install -e /home/frappe/frappe-bench/apps/erpnextswiss && /home/frappe/frappe-bench/env/bin/python -m pip check
RUN /home/frappe/frappe-bench/env/bin/python /home/frappe/frappe-bench/apps/erpnextswiss/ops/vat-release/verify_source.py /opt/kt-vat-source-manifest.json
LABEL ch.ktwaerme.erpnextswiss.commit=${ERP_REVISION}
